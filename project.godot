; Data Structure Lab — Godot 4.7
config_version=5

[application]
config/name="数据结构实验室"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="可交互的数据结构教学动画"

[display]
window/size/viewport_width=1600
window/size/viewport_height=960
window/size/window_width_override=1440
window/size/window_height_override=864
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.992, 0.965, 0.890, 1)
textures/default_filters/use_nearest_mipmap_filter=false
